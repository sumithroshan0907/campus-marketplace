# ===== Database =====
DB_URL=jdbc:mysql://localhost:3306/campus_marketplace?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ===== JWT =====
JWT_SECRET=campus-marketplace-super-secret-key-that-is-at-least-256-bits-long-for-hs256

# ===== College Email Domain =====
COLLEGE_EMAIL_DOMAIN=@college.edu

# ===== File Upload =====
UPLOAD_DIRECTORY=uploads

# ===== Email (optional — set MAIL_ENABLED=true to enable) =====
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173

# ===== Listing Moderation =====
LISTING_REQUIRE_APPROVAL=false

# ===== Data Seeder =====
SEED_ENABLED=true
